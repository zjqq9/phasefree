function UI:Notification(Config)
    Config = Config or {}
    if not notificationHost or not notificationHost.Parent then
        notificationScreen = VexUI:Create("ScreenGui", {
            Name = "VexNotifications", Parent = game:GetService("CoreGui"),
            ResetOnSpawn = false, DisplayOrder = 1000,
        })
        -- A passive container: transparent space must never capture UI input.
        notificationHost = VexUI:Create("Frame", {
            Name = "Notifications", Parent = notificationScreen,
            AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 16),
            Size = UDim2.new(1, -32, 0, 0), BackgroundTransparency = 1,
            AutomaticSize = Enum.AutomaticSize.Y,
