        }, {
            VexUI:Create("UISizeConstraint", {MaxSize = Vector2.new(360, 600)}),
            Utility:ListLayout("V", 10), Utility:Padding(3),
        })
    end
    notificationOrder += 1
    local duration = math.max(0.5, tonumber(Config.Duration) or 5)
    local card = VexUI:Create("CanvasGroup", {
        Name = "Notification", Parent = notificationHost,
        LayoutOrder = notificationOrder, AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, 0, 0, 0), BorderSizePixel = 0,
        BackgroundTransparency = 0.06, GroupTransparency = 1, ZIndex = 2001,
        Active = false, Selectable = false,
        ThemeID = {BackgroundColor3 = "ElementColor"},
    }, {
        VexUI:Create("UICorner", {CornerRadius = UDim.new(0, 8)}),
        Utility:GlassStroke("Outline", 1),
        VexUI:Create("UISizeConstraint", {MinSize = Vector2.new(0, 68)}),
    })
    local textLeft = Config.Icon and 42 or 16
    local content = VexUI:Create("Frame", {
        Parent = card, BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, -textLeft - 38, 0, 0),
        Position = UDim2.new(0, textLeft, 0, 0), ZIndex = 2002,
    }, {Utility:ListLayout("V", 5), Utility:Padding({top = 14, bottom = 18})})
    VexUI:Create("TextLabel", {
        Parent = content, Text = tostring(Config.Title or "Notification"),
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 16),
        AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true,
        TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = 1, ZIndex = 2003, ThemeID = {TextColor3 = "Text"},
    })
    if Config.Desc and tostring(Config.Desc) ~= "" then
        VexUI:Create("TextLabel", {
            Parent = content, Text = tostring(Config.Desc),
            BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 15),
            AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true,
            FontFace = Font.fromEnum(Enum.Font.Gotham),
            TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
            LayoutOrder = 2, ZIndex = 2003, ThemeID = {TextColor3 = "Muted"},
        })
    end
    if Config.Icon then
        VexUI:Create("ImageLabel", {
            Parent = card, Image = GetIcon(Config.Icon), BackgroundTransparency = 1,
            Position = UDim2.new(0, 16, 0, 15), Size = UDim2.new(0, 16, 0, 16),
            ZIndex = 2003, ThemeID = {ImageColor3 = "Accent"},
        })
    end
    local close = VexUI:Create("ImageButton", {
        Parent = card, Image = GetIcon("x"), BackgroundTransparency = 1,
        Position = UDim2.new(1, -34, 0, 8), Size = UDim2.new(0, 28, 0, 28),
        ImageTransparency = 1, ZIndex = 2004,
    }, {VexUI:Create("ImageLabel", {
        Image = GetIcon("x"), BackgroundTransparency = 1,
        Position = UDim2.new(0.5, -6, 0.5, -6), Size = UDim2.new(0, 12, 0, 12),
        ZIndex = 2005, ThemeID = {ImageColor3 = "Muted"},
    })})
    local track = VexUI:Create("Frame", {
        Parent = card, BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 1, -5), Size = UDim2.new(1, -32, 0, 2), ZIndex = 2003,
    })
    local progress = VexUI:Create("Frame", {
        Parent = track, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 0.25,
        ZIndex = 2003, ThemeID = {BackgroundColor3 = "Accent"},
    }, {VexUI:Create("UICorner", {CornerRadius = UDim.new(1, 0)})})
    activeNotifs += 1
    UI.Notifications = activeNotifs
    local dismissed, counted = false, true
    local function Uncount()
        if not counted then return end
        counted = false
        activeNotifs = math.max(0, activeNotifs - 1)
        UI.Notifications = activeNotifs
    end
    local function Dismiss()
        if dismissed then return end
        dismissed = true
        Uncount()
        if not card.Parent then return end
        Utility:TweenObject(card, {GroupTransparency = 1}, 0.14)
        task.delay(0.14, function()
            card:Destroy()
            if activeNotifs == 0 and notificationScreen then
                notificationScreen:Destroy()
                notificationScreen = nil
                notificationHost = nil
            end
        end)
    end
    card.Destroying:Once(function() dismissed = true; Uncount() end)
    close.Activated:Connect(Dismiss)
    Utility:TweenObject(card, {GroupTransparency = 0}, 0.16)
    Utility:TweenObject(progress, {Size = UDim2.new(0, 0, 1, 0)}, duration, Enum.EasingStyle.Linear)
    task.delay(duration, Dismiss)
    return {Close = Dismiss}
end

