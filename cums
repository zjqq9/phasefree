function VexUI:Create(class, properties, children)
    properties = properties or {}
    local inst = Instance.new(class)
    local requestedFontFace, requestedFont = properties.FontFace, properties.Font

    local defaults = VexUI.DefaultProps[class]
    if defaults then
        for prop, val in next, defaults do
            if properties[prop] == nil then
                properties[prop] = val
            end
        end
    end

    for property, Value in next, properties or {} do
        if property ~= "ThemeID" then
            inst[property] = Value
        end
    end

    -- Font and FontFace address the same font; explicit input wins over defaults.
    if requestedFontFace ~= nil then
        inst.FontFace = requestedFontFace
    elseif requestedFont ~= nil then
        inst.Font = requestedFont
    end

    -- Use one font family for all UI text instead of mixed Gotham aliases.
    if class == "TextLabel" or class == "TextButton" or class == "TextBox" then
        local weight = inst.FontFace.Weight
        local bold = weight == Enum.FontWeight.SemiBold or weight == Enum.FontWeight.Bold
            or weight == Enum.FontWeight.ExtraBold or weight == Enum.FontWeight.Heavy
        inst.FontFace = Font.fromEnum(bold and Enum.Font.ArialBold or Enum.Font.Arial)
    end
    for _, Child in next, children or {} do
        Child.Parent = inst
    end

    if properties.ThemeID then
        VexUI:AddThemeObject(inst, properties.ThemeID)
    end
    return inst
end


function VexUI:GetThemeProperty(property, theme, fallbackProperty)
    local function resolve(t, key)
        for _, part in ipairs(string.split(key, ".")) do
            if type(t) ~= "table" then return nil end
            t = t[part]
        end
        return t
    end

    return resolve(theme, property) 
        or resolve(VexUI.Themes["Dark"], property)
        or (fallbackProperty and (resolve(theme, fallbackProperty) or resolve(VexUI.Themes["Dark"], fallbackProperty)))
end

local themeTweens = setmetatable({}, {__mode = "k"})

function VexUI:AddThemeObject(object, properties)
    if not VexUI.Objects[object] then
        object.Destroying:Once(function()
            if themeTweens[object] then themeTweens[object]:Cancel() end
            themeTweens[object] = nil
            VexUI.Objects[object] = nil
        end)
    end
    VexUI.Objects[object] = { Object = object, Properties = properties }
    VexUI:UpdateTheme(object, false)
    return object
end

function VexUI:UpdateTheme(targetObject, isTween)
    local function ApplyTheme(objData)
        local object = objData.Object
        if themeTweens[object] then
            themeTweens[object]:Cancel()
            themeTweens[object] = nil
        end
        local targetColors = {}
        for property, colorKey in pairs(objData.Properties or {}) do
            local color = nil
            for _, key in ipairs(string.split(colorKey, "|")) do
                key = key:gsub("%s+", "")
                color = VexUI:GetThemeProperty(key, UI.Theme)
                if color then break end
            end

            if color then
                targetColors[property] = color
            end
        end
        if not next(targetColors) then return end
        if not isTween then
            for property, color in pairs(targetColors) do object[property] = color end
            return
        end
        -- Start at the currently displayed colors, including an interrupted transition.
        local tween = TweenService:Create(object,
            TweenInfo.new(0.45, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), targetColors)
        themeTweens[object] = tween
        tween.Completed:Once(function()
            if themeTweens[object] == tween then themeTweens[object] = nil end
        end)
        tween:Play()
    end

    if targetObject then
        local objData = VexUI.Objects[targetObject]
        if objData then ApplyTheme(objData) end
    else
        for _, objData in pairs(VexUI.Objects) do
            ApplyTheme(objData)
        end
    end
end

