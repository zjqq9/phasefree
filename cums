        function Tab:Slider(Config)
            local Slider = {
                Title = Config.Title or "Slider",
                Desc = Config.Desc or nil,
                Locked = Config.Locked or false,
                Step = Config.Step or 1,
                Value = Config.Value or { Min = 0, Max = 100, Default = 50 },
                Callback = Config.Callback or function() end,
                Locked = Config.Locked,
                SizeY = Config.SizeY or 40,
            }
            -- Never expose binary floating-point tails in the displayed value.
            local function FormatValue(value)
                local text = string.format("%.10f", value):gsub("0+$", ""):gsub("%.$", "")
                return text == "-0" and "0" or text
            end
            local function NormalizeValue(value)
                local minimum, maximum = Slider.Value.Min, Slider.Value.Max
                local step = tonumber(Slider.Step) or 1
                if step <= 0 or step ~= step or step == math.huge then step = 1 end
                local clamped = math.clamp(value, minimum, maximum)
                local snapped = math.round(clamped / step) * step
                return tonumber(FormatValue(math.clamp(snapped, minimum, maximum)))
            end
            local function ValueRatio(value)
                local span = Slider.Value.Max - Slider.Value.Min
                return span > 0 and math.clamp((value - Slider.Value.Min) / span, 0, 1) or 0
            end
            local Beeee, SliderElement, Inner = Utility:Element(RightScroll, ElementFrame, Slider.SizeY, "Slider")
            Inner.Size = UDim2.new(1, -182, 0, 0)
            Inner.AutomaticSize = Enum.AutomaticSize.Y
