                    ThemeID = {
                        TextColor3 = "Slider.Text|Text"
                    }
                }),
            })

            function Slider:Lock()
                Slider.Locked = true
                LockedElm(Beeee,true)
            end
            function Slider:UnLock()
                Slider.Locked = false
                LockedElm(Beeee,false)
            end
            if Slider.Locked then
                Slider:Lock()
            end

            local Value = NormalizeValue(Slider.Value.Default or Slider.Value.Min)
            DropValue.Size = UDim2.new(ValueRatio(Value), 0, 1, 0)
            local dragInput, moveConnection, endConnection
            local previousScrolling
            local dragStartValue
            local function StopDrag()
                if not dragInput then return end
                dragInput = nil
                HoldingSlider = false
                if Value ~= dragStartValue then NotifyAction(Slider.Title, FormatValue(Value)) end
                if moveConnection then moveConnection:Disconnect(); moveConnection = nil end
                if endConnection then endConnection:Disconnect(); endConnection = nil end
                if RightScroll.Parent then RightScroll.ScrollingEnabled = previousScrolling end
            end
            local function MoveTo(position)
                if Slider.Locked or not Window.IslandOpen then StopDrag(); return end
                local ratio = math.clamp((position.X - ValueFrame.AbsolutePosition.X)
                    / math.max(1, ValueFrame.AbsoluteSize.X), 0, 1)
                local nextValue = NormalizeValue(Slider.Value.Min + ratio * (Slider.Value.Max - Slider.Value.Min))
                -- Track the finger directly; repeated tweens made dragging lag behind.
                DropValue.Size = UDim2.new(ValueRatio(nextValue), 0, 1, 0)
                BGBox.Text = FormatValue(nextValue)
                if nextValue ~= Value then
                    Value = nextValue
                    task.spawn(Slider.Callback, nextValue)
                end
            end
            SliderTRG.InputBegan:Connect(function(input)
                if Slider.Locked or HoldingSlider then return end
                local touch = input.UserInputType == Enum.UserInputType.Touch
                if not touch and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
                dragInput = input
                dragStartValue = Value
                HoldingSlider = true
                previousScrolling = RightScroll.ScrollingEnabled
                RightScroll.ScrollingEnabled = false
                MoveTo(input.Position)
                moveConnection = UserInputService.InputChanged:Connect(function(changed)
                    if (touch and changed == dragInput)
                        or (not touch and changed.UserInputType == Enum.UserInputType.MouseMovement) then
                        MoveTo(changed.Position)
                    end
                end)
                endConnection = UserInputService.InputEnded:Connect(function(ended)
                    if ended == dragInput or (not touch and ended.UserInputType == Enum.UserInputType.MouseButton1) then
                        StopDrag()
                    end
                end)
            end)
            local focusConnection = UserInputService.WindowFocusReleased:Connect(StopDrag)
            local visibilityConnection = Main:GetPropertyChangedSignal("Visible"):Connect(function()
                if not Main.Visible then StopDrag() end
            end)
            local pageConnection = ElementFrame:GetPropertyChangedSignal("Visible"):Connect(function()
                if not ElementFrame.Visible then StopDrag() end
            end)
            Beeee.Destroying:Once(function()
                StopDrag()
                focusConnection:Disconnect()
                visibilityConnection:Disconnect()
                pageConnection:Disconnect()
            end)

            function Slider:SetValue(val)
                local rounded = NormalizeValue(val)
                Value = rounded
                BGBox.Text = FormatValue(rounded)
                ScrollFrame:FindFirstChildOfClass("TextLabel").Text = FormatValue(rounded)
                Utility:TweenObject(DropValue, {Size = UDim2.new(ValueRatio(rounded),0, 1, 0)}, 0.1, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
                task.spawn(Slider.Callback, rounded)
            end

            function Slider:SetDesc(val)
                Desc.Frame.Visible = true
                Desc.SetText(val)
            end
            function Slider:SetMax(val)
                Slider.Value.Max = val
            end
            function Slider:SetMin(val)
                Slider.Value.Min = val
            end
            function Slider:SetStep(val)
                Slider.Step = val
                self:SetValue(Value)
            end
            function Slider:Close()
                Beeee:Destroy()
            end
            Utility:Search(Window, {Title = Slider.Title, Desc = Slider.Desc, Icon = "settings-2",Type = "Slider", TabTitle = Tab.Title, SelectFn = SelectTab, Frame = Beeee, RightScroll = RightScroll,})
            return Slider
        end
